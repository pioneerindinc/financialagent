# PRODUCTION CONTRACT — names only; this is not a ready-to-run env file.
# PIONEERSERV: populate a centralized, ACL-protected file outside each release.
# Do not deploy workstation .env.local or .local files. Never use NEXT_PUBLIC
# variables for credentials. See docs/PIONEERSERV_DEPLOYMENT.md.

# Required production process setting: set NODE_ENV to production.
NODE_ENV=
# Required for DB readiness and finance operations. Explicit dedicated database;
# replica-set (or supported sharded cluster) URI, never an ERP/test/dev database.
MONGODB_URI=
# Required for human access/mutations: canonical external HTTPS application URL.
APP_BASE_URL=
# Required for human sign-in: exact issuer/audience and HTTPS RS256 JWKS endpoint.
# These verify a trusted issued session; they do not create a login provider.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Optional: omit/blank for no service access. Otherwise a JSON array of records:
# id, sha256 (64 lowercase hex), companies (exact IDs), scopes, expiresAt (ISO).
# Allowed scopes: finance:read, finance:source:write, ar:read, ap:read, cfo:read.
# Never put plaintext tokens here. Service identities cannot post/reverse journals.
SERVICE_CREDENTIALS_JSON=
# Optional Next CLI port. Set via service environment or explicit --port;
# do not rely on a .env file loaded internally by Next to select its port.
PORT=
# Optional framework telemetry opt-out; set to 1 if required by platform policy.
NEXT_TELEMETRY_DISABLED=
# Optional BUILD-TIME shared Server Actions key; normally leave unset for this
# single-instance app (no Server Actions). If needed, use base64 AES key material
# consistently at build time; protect build output. Not an authentication secret.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Operator-only: required only for an explicitly approved bootstrap invocation.
# Do not auto-bootstrap during build, service start, or deployment.
BOOTSTRAP_ACTOR=

# DEVELOPMENT ONLY — omit these from PIONEERSERV, or set enabled to false.
# NODE_ENV=production always rejects development issuance and development cookies.
# Local setup generates DEV_AUTH_SECRET privately; never copy it to a server.
DEV_AUTH_ENABLED=
DEV_AUTH_SECRET=
# Internal local-launcher flags; never configure them in production.
DEV_AUTH_LOCAL_LAUNCH=
FINANCE_LOCAL_DEV_BUILD=
