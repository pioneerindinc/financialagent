# Required production settings; real values belong in the protected centralized env file.
NODE_ENV=production
MONGODB_URI=
APP_BASE_URL=https://finance.pioneercryo.com
# Explicit internal password/session bridge. Unset defaults to legacy external mode.
AUTH_MODE=internal
# Internal only: 32 independently random bytes encoded as 64 lowercase hex characters.
# Never reuse DEV_AUTH_SECRET or expose through NEXT_PUBLIC_*. Rotation signs everyone out.
AUTH_SESSION_SECRET=
# External mode only: exact RS256 issuer, audience, and HTTPS JWKS URL.
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_JWKS_URL=

SERVICE_CREDENTIALS_JSON=[]
# Optional service-only hashed bearer credentials; never human login/passwords.
# Optional approved port (Next default 3000) and telemetry opt-out:
# PORT=
# NEXT_TELEMETRY_DISABLED=1


# Operator-only accounting bootstrap attribution; not required by auth-user.ts or runtime.
# BOOTSTRAP_ACTOR=

# Development only — do not configure in production:
# DEV_AUTH_ENABLED=
# DEV_AUTH_LOCAL_LAUNCH=
# DEV_AUTH_SECRET=
# FINANCE_LOCAL_DEV_BUILD=

# Optional framework-managed value. Not required for PioneerServ deployment:
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
