# Real credentials and machine-specific values belong in ignored local
# environment files (such as .env.local), never in this example file.

# Required for database-backed application operations.
MONGODB_URI=

# Application/authentication configuration.
# AUTH_MODE is optional and defaults to external.
AUTH_MODE=
# Required in either authentication mode.
APP_BASE_URL=
# Required in external auth mode:
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# Required only when AUTH_MODE=internal:
AUTH_SESSION_SECRET=

# Optional service-to-service credentials; defaults to an empty list.
SERVICE_CREDENTIALS_JSON=[]

# Optional Pioneer AR integration. Required to use its ERP preview/import.
PIONEER_ERP_BASE_URL=
FINANCIAL_AGENT_API_KEY=
PIONEER_AR_COMPANY_ID=
# Optional; absent or any value other than "true" leaves authority disabled.
PIONEER_AR_AUTHORITATIVE_ENABLED=

# Optional development/local setup settings.
NODE_ENV=
DEV_AUTH_ENABLED=
# Generated by local setup; keep the actual secret in ignored .env.local.
DEV_AUTH_SECRET=
# Required only when explicitly running the company bootstrap operation.
# BOOTSTRAP_ACTOR=

# Optional framework settings.
PORT=
NEXT_TELEMETRY_DISABLED=
