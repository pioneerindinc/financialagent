    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "mongodb": "^7.6.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4",
