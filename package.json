    "dev:db:start": "tsx scripts/local/database.ts start",
    "dev:db:status": "tsx scripts/local/database.ts status",
    "dev:db:stop": "tsx scripts/local/database.ts stop",
    "dev:db:reset": "tsx scripts/local/database.ts reset",
    "dev:bootstrap": "tsx scripts/local/bootstrap.ts",
    "dev:local": "tsx scripts/local/start.ts",
    "dev:verify": "playwright test --config=playwright.local.config.ts"
